#!/usr/bin/env bash
# argus-discover — Scan a subnet for ARGUS nodes and generate Prometheus targets.
#
# Usage:
#   argus-discover --subnet 10.0.0.0/24
#   argus-discover --subnet 10.0.0.0/24 --port 9100 --output /etc/prometheus/argus-targets.json
#   argus-discover --subnet 10.0.0.0/24 --label cluster=gpu-rack-1
#   argus-discover --subnet 192.168.5.0/24 --timeout 2 --dry-run
#
# The script probes each IP on the ARGUS metrics port (default 9100) looking for
# a valid /health endpoint. Discovered nodes are written as a Prometheus
# file_sd_configs JSON file that Prometheus hot-reloads automatically.
#
# Requirements: bash 4+, curl (or nc as fallback)

set -euo pipefail

PORT=9100
OUTPUT=""
TIMEOUT=2
DRY_RUN=false
START_STACK=false
ENABLE_SLURM=false
SSH_USER="root"
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new"
LABELS=()
SUBNET=""

usage() {
    cat <<EOF
Usage: argus-discover --subnet CIDR [OPTIONS]

Options:
  --subnet CIDR       Subnet to scan (e.g. 10.0.0.0/24, 192.168.1.0/24)
  --port PORT         ARGUS metrics port (default: 9100)
  --output FILE       Write targets JSON here (default: stdout)
  --label KEY=VALUE   Add label to all discovered targets (repeatable)
  --timeout SECS      Connection timeout per host (default: 2)
  --dry-run           Print discovered hosts but don't write file
  --start             Discover nodes then start the Grafana + Prometheus stack
  --enable-slurm      After discovery, ssh to each node and run
                      'argus-scheduler enable slurm' (requires passwordless
                      ssh as --ssh-user; validates SLURM on each node first)
  --ssh-user USER     ssh user for --enable-slurm (default: root)
  --ssh-opts OPTS     Extra ssh options for --enable-slurm
                      (default: ${SSH_OPTS})
  -h, --help          Show this help
EOF
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --subnet)   SUBNET="$2"; shift 2 ;;
        --port)     PORT="$2"; shift 2 ;;
        --output)   OUTPUT="$2"; shift 2 ;;
        --label)    LABELS+=("$2"); shift 2 ;;
        --timeout)  TIMEOUT="$2"; shift 2 ;;
        --dry-run)  DRY_RUN=true; shift ;;
        --start)    START_STACK=true; shift ;;
        --enable-slurm) ENABLE_SLURM=true; shift ;;
        --ssh-user) SSH_USER="$2"; shift 2 ;;
        --ssh-opts) SSH_OPTS="$2"; shift 2 ;;
        -h|--help)  usage ;;
        *)          echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

if [[ -z "$SUBNET" ]]; then
    echo "Error: --subnet is required" >&2
    usage
fi

cidr_to_ips() {
    local cidr="$1"
    local base="${cidr%/*}"
    local mask="${cidr#*/}"

    if [[ "$cidr" != */* ]]; then
        mask=32
    fi
    if [[ ! "$mask" =~ ^[0-9]+$ ]] || (( mask > 32 )); then
        echo "Error: invalid CIDR mask in '${cidr}'" >&2
        exit 1
    fi
    if [[ ! "$base" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "Error: invalid IPv4 base address in '${cidr}'" >&2
        exit 1
    fi

    IFS='.' read -r a b c d <<< "$base"
    local ip_num=$(( (a << 24) + (b << 16) + (c << 8) + d ))
    local host_bits=$(( 32 - mask ))
    local num_hosts=$(( 1 << host_bits ))

    local network=$(( ip_num & ( (0xFFFFFFFF << host_bits) & 0xFFFFFFFF ) ))

    # /31 and /32 have no network/broadcast addresses — probe every address
    # in the range (RFC 3021). Larger subnets skip .0 and broadcast.
    local first=1 last=$(( num_hosts - 2 ))
    if (( mask >= 31 )); then
        first=0
        last=$(( num_hosts - 1 ))
    fi

    for (( i = first; i <= last; i++ )); do
        local addr=$(( network + i ))
        printf "%d.%d.%d.%d\n" \
            $(( (addr >> 24) & 255 )) \
            $(( (addr >> 16) & 255 )) \
            $(( (addr >> 8) & 255 )) \
            $(( addr & 255 ))
    done
}

probe_host() {
    local ip="$1"
    if curl -sf --connect-timeout "$TIMEOUT" --max-time "$((TIMEOUT + 1))" \
        "http://${ip}:${PORT}/health" >/dev/null 2>&1; then
        echo "$ip"
    fi
}

echo "Scanning ${SUBNET} on port ${PORT}..." >&2

RESULT_FILE=$(mktemp)
trap 'rm -f "$RESULT_FILE"' EXIT

mapfile -t IPS < <(cidr_to_ips "$SUBNET")
TOTAL=${#IPS[@]}
ACTIVE=0
MAX_PARALLEL=128

for ip in "${IPS[@]}"; do
    ( probe_host "$ip" >> "$RESULT_FILE" ) &
    ACTIVE=$((ACTIVE + 1))
    if (( ACTIVE >= MAX_PARALLEL )); then
        wait -n 2>/dev/null || wait
        ACTIVE=$((ACTIVE - 1))
    fi
done
wait

mapfile -t DISCOVERED < "$RESULT_FILE"

echo "Found ${#DISCOVERED[@]} ARGUS node(s) out of ${TOTAL} scanned." >&2

if [[ ${#DISCOVERED[@]} -eq 0 ]]; then
    echo "No nodes found." >&2
    exit 0
fi

if $DRY_RUN; then
    for ip in "${DISCOVERED[@]}"; do
        echo "  $ip:$PORT"
    done
    if $ENABLE_SLURM; then
        echo "" >&2
        echo "[dry-run] would enable SLURM integration on ${#DISCOVERED[@]} node(s) via:" >&2
        echo "[dry-run]   ssh ${SSH_USER}@<node> argus-scheduler enable slurm" >&2
    fi
    exit 0
fi

# Fleet-wide SLURM enablement: ssh to each discovered node and turn on the
# scheduler integration. Each node validates its own SLURM setup (scontrol,
# munge, registration) before flipping the config, so a node with broken
# SLURM reports failure instead of silently degrading.
enable_slurm_fleet() {
    local ok=0 fail=0
    echo "Enabling SLURM scheduler integration on ${#DISCOVERED[@]} node(s)..." >&2
    for ip in "${DISCOVERED[@]}"; do
        # shellcheck disable=SC2086  # SSH_OPTS is intentionally word-split
        if ssh $SSH_OPTS "${SSH_USER}@${ip}" "argus-scheduler enable slurm" >/dev/null 2>&1; then
            echo "  ✓ ${ip} — SLURM integration enabled" >&2
            ok=$((ok + 1))
        else
            echo "  ✗ ${ip} — failed (run 'ssh ${SSH_USER}@${ip} argus-scheduler validate' to diagnose)" >&2
            fail=$((fail + 1))
        fi
    done
    echo "SLURM enablement: ${ok} OK, ${fail} failed." >&2
    if [[ $fail -gt 0 ]]; then
        SLURM_ENABLE_FAILURES=$fail
    fi
}

SLURM_ENABLE_FAILURES=0
if $ENABLE_SLURM; then
    enable_slurm_fleet
fi

# Build targets JSON (Prometheus file_sd_configs format)
build_json() {
    local targets=""
    for ip in "${DISCOVERED[@]}"; do
        [[ -n "$targets" ]] && targets+=","
        targets+="\"${ip}:${PORT}\""
    done

    local labels_json="\"job\":\"argus\""
    for lbl in "${LABELS[@]+"${LABELS[@]}"}"; do
        local key="${lbl%%=*}"
        local val="${lbl#*=}"
        labels_json+=",\"${key}\":\"${val}\""
    done

    cat <<ENDJSON
[
  {
    "targets": [${targets}],
    "labels": {${labels_json}}
  }
]
ENDJSON
}

JSON=$(build_json)

# Locate the observability stack directory (needed for --start and default output)
for candidate in \
    "$PWD/deploy/observability" \
    "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)/deploy/observability" \
; do
    if [[ -f "$candidate/docker-compose.yml" ]]; then
        STACK_DIR="$candidate"
        break
    fi
done

if $START_STACK; then
    if [[ -z "${STACK_DIR:-}" ]]; then
        echo "Error: cannot find deploy/observability/docker-compose.yml." >&2
        echo "Run this from the ARGUS repo root, or use --output and start the stack manually." >&2
        exit 1
    fi
    TARGETS_FILE="${OUTPUT:-$STACK_DIR/argus-targets.json}"
    mkdir -p "$(dirname "$TARGETS_FILE")"
    echo "$JSON" > "$TARGETS_FILE"
    echo "Wrote ${TARGETS_FILE}" >&2
    echo "Starting observability stack..." >&2
    exec "$STACK_DIR/scripts/start-observability.sh"
elif [[ -n "$OUTPUT" ]]; then
    mkdir -p "$(dirname "$OUTPUT")"
    echo "$JSON" > "$OUTPUT"
    echo "Wrote ${OUTPUT}" >&2
else
    # No explicit --output: write to the default targets file if the stack
    # directory exists, so Prometheus picks up changes automatically.
    if [[ -n "${STACK_DIR:-}" ]]; then
        TARGETS_FILE="$STACK_DIR/argus-targets.json"
        echo "$JSON" > "$TARGETS_FILE"
        echo "Wrote ${TARGETS_FILE}" >&2
        echo "Prometheus will reload targets within 30 seconds." >&2
    else
        echo "$JSON"
    fi
fi

# Surface partial SLURM-enable failures in the exit code so fleet tooling
# (Ansible, cron) notices, while still writing the targets file above.
if [[ "${SLURM_ENABLE_FAILURES}" -gt 0 ]]; then
    exit 1
fi
