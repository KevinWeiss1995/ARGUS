#
# File contexts for ARGUS — Adaptive RDMA Guard & Utilization Sentinel
#
# Apply with: restorecon -RFv /usr/bin/argusd /etc/argus /var/lib/argus /var/run/argus
#

/usr/bin/argusd                              --      gen_context(system_u:object_r:argusd_exec_t,s0)
/usr/bin/argus-tui                           -l      gen_context(system_u:object_r:argusd_exec_t,s0)

# Read-only artefacts shipped by the RPM
/usr/lib(64)?/argus(/.*)?                            gen_context(system_u:object_r:argusd_exec_t,s0)

# Configuration
/etc/argus(/.*)?                                     gen_context(system_u:object_r:argusd_etc_t,s0)

# Persistent state, scheduler audit log, ebpf hash
/var/lib/argus(/.*)?                                 gen_context(system_u:object_r:argusd_var_lib_t,s0)

# Runtime (PID file, scheduler lock)
/var/run/argus(/.*)?                                 gen_context(system_u:object_r:argusd_var_run_t,s0)
/run/argus(/.*)?                                     gen_context(system_u:object_r:argusd_var_run_t,s0)

# Logs (if logging to file rather than journald)
/var/log/argus(/.*)?                                 gen_context(system_u:object_r:argusd_log_t,s0)
