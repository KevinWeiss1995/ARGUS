    {
      "id": 7, "type": "table", "title": "Unhealthy Nodes",
      "description": "Nodes NOT in Healthy state, sorted by score (worst first). Empty = everything is fine. Click instance to drill down.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" }, "editorMode": "code",
          "expr": "argus_health_state{instance=~\"$node\"} != 0", "refId": "A",
          "exemplar": false, "format": "table", "instant": true, "legendFormat": "State", "range": false },
        { "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" }, "editorMode": "code",
          "expr": "argus_health_score_millis{instance=~\"$node\"} / 1000 and argus_health_state{instance=~\"$node\"} != 0", "refId": "B",
          "exemplar": false, "format": "table", "instant": true, "legendFormat": "Score", "range": false },
        { "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" }, "editorMode": "code",
          "expr": "argus_ib_error_delta_total{instance=~\"$node\"} and argus_health_state{instance=~\"$node\"} != 0", "refId": "C",
          "exemplar": false, "format": "table", "instant": true, "legendFormat": "IB Errors", "range": false },
        { "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" }, "editorMode": "code",
          "expr": "argus_napi_utilization_pct{instance=~\"$node\"} and argus_health_state{instance=~\"$node\"} != 0", "refId": "D",
          "exemplar": false, "format": "table", "instant": true, "legendFormat": "NAPI %", "range": false },
        { "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" }, "editorMode": "code",
          "expr": "argus_irq_imbalance_pct{instance=~\"$node\"} and argus_health_state{instance=~\"$node\"} != 0", "refId": "E",
          "exemplar": false, "format": "table", "instant": true, "legendFormat": "IRQ Skew", "range": false },
        { "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" }, "editorMode": "code",
          "expr": "argus_scheduler_desired_state{instance=~\"$node\"} and argus_health_state{instance=~\"$node\"} != 0", "refId": "F",
          "exemplar": false, "format": "table", "instant": true, "legendFormat": "Sched", "range": false }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true, "inspect": false },
          "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "noValue": "All nodes healthy"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "State" }, "properties": [
            { "id": "mappings", "value": [{ "type": "value", "options": {
              "0": { "color": "green", "index": 0, "text": "Healthy" },
              "1": { "color": "yellow", "index": 1, "text": "Degraded" },
              "2": { "color": "red", "index": 2, "text": "Critical" },
              "3": { "color": "orange", "index": 3, "text": "Recovering" }
            }}]},
            { "id": "custom.cellOptions", "value": { "type": "color-background" } }
          ]},
          { "matcher": { "id": "byName", "options": "NAPI %" }, "properties": [
            { "id": "unit", "value": "percent" },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]}},
            { "id": "custom.cellOptions", "value": { "type": "color-background" } }
          ]},
          { "matcher": { "id": "byName", "options": "IRQ Skew" }, "properties": [
            { "id": "unit", "value": "percent" },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 70 }
            ]}},
            { "id": "custom.cellOptions", "value": { "type": "color-background" } }
          ]},
          { "matcher": { "id": "byName", "options": "Score" }, "properties": [
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.55 }
            ]}},
            { "id": "custom.cellOptions", "value": { "type": "color-background" } }
          ]},
          { "matcher": { "id": "byName", "options": "Sched" }, "properties": [
            { "id": "mappings", "value": [{ "type": "value", "options": {
              "0": { "color": "green", "index": 0, "text": "Available" },
              "1": { "color": "yellow", "index": 1, "text": "Draining" },
              "2": { "color": "purple", "index": 2, "text": "Held" }
            }}]},
            { "id": "custom.cellOptions", "value": { "type": "color-background" } }
          ]},
          { "matcher": { "id": "byName", "options": "instance" }, "properties": [
            { "id": "links", "value": [
              { "title": "Open node detail", "url": "/d/argus-node-detail?var-node=${__value.text}", "targetBlank": true }
            ]}
          ]}
        ]
      },
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": true, "fields": "", "reducer": ["count"], "show": true },
        "showHeader": true, "sortBy": [{ "desc": true, "displayName": "Score" }]
      },
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
          "excludeByName": { "Time": true, "__name__": true, "job": true },
          "indexByName": {},
          "renameByName": { "Value #A": "State", "Value #B": "Score", "Value #C": "IB Errors", "Value #D": "NAPI %", "Value #E": "IRQ Skew", "Value #F": "Sched" }
        }}
      ]
    },

    {
      "id": 8, "type": "table", "title": "Recent Alerts (5m)",
      "description": "Alert rule firings aggregated by kind and severity over the last 5 minutes.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 41 },
