{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Node Detail", "url": "/d/argus-node-detail?var-node=${__data.fields.instance}", "type": "link" },
    { "title": "Link Drill-Down", "url": "/d/argus-link-drilldown", "type": "link" }
  ],
  "liveNow": false,
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Nodes Healthy",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
        "editorMode": "code",
        "expr": "count(argus_health_state{instance=~\"$node\"} == 0) or vector(0)",
        "refId": "A", "instant": true, "range": false
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "none", "noValue": "0"
        }, "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "id": 2, "type": "stat", "title": "Nodes Degraded",
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
        "editorMode": "code",
        "expr": "count(argus_health_state{instance=~\"$node\"} == 1) or vector(0)",
        "refId": "A", "instant": true, "range": false
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "yellow", "mode": "fixed" },
          "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "yellow", "value": null }] },
          "unit": "none", "noValue": "0"
        }, "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "id": 3, "type": "stat", "title": "Nodes Critical",
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
        "editorMode": "code",
        "expr": "count(argus_health_state{instance=~\"$node\"} == 2) or vector(0)",
        "refId": "A", "instant": true, "range": false
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] },
          "unit": "none", "noValue": "0"
        }, "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "id": 16, "type": "stat", "title": "Nodes Recovering",
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
        "editorMode": "code",
        "expr": "count(argus_health_state{instance=~\"$node\"} == 3) or vector(0)",
        "refId": "A", "instant": true, "range": false
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] },
          "unit": "none", "noValue": "0"
        }, "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "id": 4, "type": "gauge", "title": "Worst Health Score",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
        "editorMode": "code",
        "expr": "max(argus_health_score_millis{instance=~\"$node\"}) / 1000 or vector(0)",
        "refId": "A", "instant": true, "range": false
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.3 },
            { "color": "red", "value": 0.55 }
          ]},
          "unit": "none", "noValue": "0"
        }, "overrides": []
      },
      "options": { "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true, "sizing": "auto",
        "minVizHeight": 75, "minVizWidth": 75,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 5, "type": "stat", "title": "Total Alerts (15m)",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
        "editorMode": "code",
        "expr": "sum(increase(argus_alerts_total{instance=~\"$node\"}[15m])) or vector(0)",
        "refId": "A", "instant": true, "range": false
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 10 }
          ]},
          "unit": "none", "noValue": "0"
        }, "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "id": 15, "type": "stat", "title": "Events Processed",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
        "editorMode": "code",
        "expr": "sum(argus_events{instance=~\"$node\"}) or vector(0)",
        "refId": "A", "instant": true, "range": false
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short", "noValue": "0"
        }, "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },

    {
      "id": 6, "type": "timeseries",
      "title": "Fleet Health Distribution",
      "description": "Number of nodes in each health state over time. Shows fleet-wide state transitions at a glance — works identically at 2 or 16,000 nodes.",
      "gridPos": { "h": 7, "w": 16, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "count(argus_health_state{instance=~\"$node\"} == 0) or vector(0)",
          "refId": "A", "legendFormat": "Healthy", "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "count(argus_health_state{instance=~\"$node\"} == 1) or vector(0)",
          "refId": "B", "legendFormat": "Degraded", "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "count(argus_health_state{instance=~\"$node\"} == 2) or vector(0)",
          "refId": "C", "legendFormat": "Critical", "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "count(argus_health_state{instance=~\"$node\"} == 3) or vector(0)",
          "refId": "D", "legendFormat": "Recovering", "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed" },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "stepAfter",
            "fillOpacity": 80, "lineWidth": 1, "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" },
            "spanNulls": true, "gradientMode": "none"
          },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Healthy" }, "properties": [
            { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
          ]},
          { "matcher": { "id": "byName", "options": "Degraded" }, "properties": [
            { "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }
          ]},
          { "matcher": { "id": "byName", "options": "Critical" }, "properties": [
            { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
          ]},
          { "matcher": { "id": "byName", "options": "Recovering" }, "properties": [
            { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
          ]}
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },

    {
      "id": 20, "type": "timeseries",
      "title": "State Transitions (rate)",
      "description": "Rate of health state transitions across the fleet. Sustained high rates indicate flapping. Spikes indicate correlated degradation events.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "sum by (from, to) (increase(argus_state_transitions_total{instance=~\"$node\"}[$__rate_interval])) > 0",
          "refId": "A", "legendFormat": "{{from}} → {{to}}", "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars", "lineInterpolation": "stepAfter",
            "fillOpacity": 60, "lineWidth": 1, "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" },
            "spanNulls": false
          },
          "unit": "short"
        }, "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },

    {
      "id": 13, "type": "heatmap",
      "title": "Health Score Distribution",
      "description": "Distribution of health scores across all nodes over time. Y-axis = score buckets, color intensity = node count. Bright bands indicate clusters of nodes with similar scores.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
        "editorMode": "code",
        "expr": "argus_health_score_millis{instance=~\"$node\"} / 1000",
        "refId": "A", "legendFormat": "{{instance}}", "range": true, "format": "time_series"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "scheme", "exponent": 0.5, "scheme": "RdYlGn", "reverse": true, "fill": "dark-green", "steps": 128 },
          "custom": {
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "scaleDistribution": { "type": "linear" }
          }
        }, "overrides": []
      },
      "options": {
        "calculate": true,
        "calculation": {
          "xBuckets": { "mode": "size" },
          "yBuckets": { "mode": "size", "value": "0.05" }
        },
        "cellGap": 1,
        "cellValues": {},
        "color": { "mode": "scheme", "exponent": 0.5, "scheme": "RdYlGn", "reverse": true, "fill": "dark-green", "steps": 128 },
        "exemplars": { "color": "rgba(255,0,255,0.7)" },
        "filterValues": { "le": 0 },
        "legend": { "show": true },
        "rowsFrame": { "layout": "auto" },
        "showValue": "never",
        "tooltip": { "mode": "single", "yHistogram": true },
        "yAxis": { "axisPlacement": "left", "min": 0, "max": 1, "unit": "none", "reverse": false }
      }
    },

    {
      "id": 21, "type": "timeseries",
      "title": "Top-10 Worst Health Scores",
      "description": "The 10 highest health scores across the fleet. Click a series label to drill into node detail. If this panel is empty, the fleet is perfectly healthy.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
        "editorMode": "code",
        "expr": "topk(10, argus_health_score_millis{instance=~\"$node\"} / 1000)",
        "refId": "A", "legendFormat": "{{instance}}", "range": true
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth",
            "fillOpacity": 15, "lineWidth": 2, "showPoints": "never",
            "gradientMode": "opacity", "spanNulls": true,
            "thresholdsStyle": { "mode": "area" }
          },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.3 },
            { "color": "red", "value": 0.55 }
          ]},
          "unit": "none", "min": 0, "max": 1,
          "links": [
            { "title": "Open node detail", "url": "/d/argus-node-detail?var-node=${__field.labels.instance}", "targetBlank": true }
          ]
        }, "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },

    {
      "id": 10, "type": "timeseries",
      "title": "IRQ Imbalance — Fleet Percentiles",
      "description": "p50 (median), p95, and p99 of IRQ imbalance across all nodes. p99 shows the worst 1% of nodes — if this is high, a small number of nodes have misconfigured interrupt affinity.",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "quantile(0.50, argus_irq_imbalance_pct{instance=~\"$node\"})",
          "refId": "A", "legendFormat": "p50 (median)", "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "quantile(0.95, argus_irq_imbalance_pct{instance=~\"$node\"})",
          "refId": "B", "legendFormat": "p95", "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "quantile(0.99, argus_irq_imbalance_pct{instance=~\"$node\"})",
          "refId": "C", "legendFormat": "p99 (worst 1%)", "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth",
            "fillOpacity": 10, "lineWidth": 2, "showPoints": "never",
            "spanNulls": true, "gradientMode": "opacity",
            "thresholdsStyle": { "mode": "line" }
          },
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "transparent", "value": null },
            { "color": "red", "value": 70 }
          ]}
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p50 (median)" }, "properties": [
            { "id": "custom.lineWidth", "value": 2 },
            { "id": "custom.fillOpacity", "value": 0 }
          ]},
          { "matcher": { "id": "byName", "options": "p99 (worst 1%)" }, "properties": [
            { "id": "custom.lineStyle", "value": { "dash": [10, 5], "fill": "dash" } },
            { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
          ]}
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },

    {
      "id": 11, "type": "timeseries",
      "title": "Slab Alloc Rate — Fleet Percentiles",
      "description": "p50, p95, p99 of kernel slab allocation rate across the fleet. High p99 with normal p50 indicates a few nodes under memory pressure.",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "quantile(0.50, increase(argus_slab_alloc_total{instance=~\"$node\"}[$__rate_interval]))",
          "refId": "A", "legendFormat": "p50 (median)", "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "quantile(0.95, increase(argus_slab_alloc_total{instance=~\"$node\"}[$__rate_interval]))",
          "refId": "B", "legendFormat": "p95", "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "quantile(0.99, increase(argus_slab_alloc_total{instance=~\"$node\"}[$__rate_interval]))",
          "refId": "C", "legendFormat": "p99 (worst 1%)", "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth",
            "fillOpacity": 10, "lineWidth": 2, "showPoints": "never",
            "spanNulls": true, "gradientMode": "opacity"
          },
          "unit": "ops"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p99 (worst 1%)" }, "properties": [
            { "id": "custom.lineStyle", "value": { "dash": [10, 5], "fill": "dash" } }
          ]}
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },

    {
      "id": 12, "type": "timeseries",
      "title": "NAPI Utilization — Fleet Percentiles",
      "description": "p50, p95, p99 of NIC polling utilization. p99 > 85% means your worst nodes are near saturation. >95% = critical.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "quantile(0.50, argus_napi_utilization_pct{instance=~\"$node\"})",
          "refId": "A", "legendFormat": "p50 (median)", "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "quantile(0.95, argus_napi_utilization_pct{instance=~\"$node\"})",
          "refId": "B", "legendFormat": "p95", "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "quantile(0.99, argus_napi_utilization_pct{instance=~\"$node\"})",
          "refId": "C", "legendFormat": "p99 (worst 1%)", "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth",
            "fillOpacity": 10, "lineWidth": 2, "showPoints": "never",
            "spanNulls": true, "gradientMode": "opacity",
            "thresholdsStyle": { "mode": "area" }
          },
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 85 },
            { "color": "red", "value": 95 }
          ]}
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p99 (worst 1%)" }, "properties": [
            { "id": "custom.lineStyle", "value": { "dash": [10, 5], "fill": "dash" } }
          ]}
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },

    {
      "id": 14, "type": "timeseries",
      "title": "Slab Latency — Fleet Percentiles",
      "description": "p50 and p99 of slab allocation latency, plus the fleet-wide maximum. Large gaps between p99 and max indicate isolated node issues.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "quantile(0.50, argus_slab_avg_latency_ns{instance=~\"$node\"})",
          "refId": "A", "legendFormat": "avg p50 (median)", "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "quantile(0.99, argus_slab_avg_latency_ns{instance=~\"$node\"})",
          "refId": "B", "legendFormat": "avg p99 (worst 1%)", "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "max(argus_slab_max_latency_ns{instance=~\"$node\"})",
          "refId": "C", "legendFormat": "fleet max", "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth",
            "fillOpacity": 10, "lineWidth": 2, "showPoints": "never",
            "spanNulls": true, "gradientMode": "opacity"
          },
          "unit": "ns"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "fleet max" }, "properties": [
            { "id": "custom.lineStyle", "value": { "dash": [4, 4], "fill": "dash" } },
            { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
            { "id": "custom.fillOpacity", "value": 0 }
          ]}
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
