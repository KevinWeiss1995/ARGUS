    {
      "id": 22, "type": "timeseries",
      "title": "IB Errors — Fleet Aggregate",
      "description": "Total IB error deltas summed across the fleet, broken down by error type. Spikes indicate fabric-wide issues.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "sum(argus_ib_symbol_errors_delta{instance=~\"$node\"}) or vector(0)",
          "refId": "A", "legendFormat": "symbol errors", "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "sum(argus_ib_link_downed_delta{instance=~\"$node\"}) or vector(0)",
          "refId": "B", "legendFormat": "link downed", "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "sum(argus_ib_link_error_recovery_delta{instance=~\"$node\"}) or vector(0)",
          "refId": "C", "legendFormat": "link error recovery", "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
          "editorMode": "code",
          "expr": "sum(argus_ib_port_rcv_errors_delta{instance=~\"$node\"}) or vector(0)",
          "refId": "D", "legendFormat": "rcv errors", "range": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "DS_PROMETHEUS" },
