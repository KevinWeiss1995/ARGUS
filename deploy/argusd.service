[Unit]
Description=ARGUS - Adaptive RDMA Guard & Utilization Sentinel
Documentation=https://github.com/KevinWeiss1995/ARGUS
After=network.target
ConditionPathExists=/etc/argus/argusd.conf

[Service]
Type=simple

# --- Execution: NO SHELL ---
# The binary reads env vars directly via clap env= attributes.
# This eliminates all shell injection risk from EnvironmentFile values.
EnvironmentFile=/etc/argus/argusd.conf
ExecStart=/usr/bin/argusd
ExecReload=/bin/kill -HUP $MAINPID

# --- Restart policy ---
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2 78
WatchdogSec=120

# --- Resource Limits ---
CPUQuota=5%
Nice=19
IOSchedulingClass=idle
MemoryMax=256M
TasksMax=64
LimitNOFILE=8192
LimitMEMLOCK=67108864

# --- Capabilities ---
#
# Default: CAP_SYS_ADMIN. This is intentionally broad because it works on
# EVERY supported kernel — including RHEL 8 / Rocky 8 stock (4.18.0-*.el8)
# where systemd 239 does not recognize the CAP_BPF / CAP_PERFMON names,
# and on pre-5.8 kernels (or RHEL 8 prior to the CAP_BPF backport) where
# those caps don't exist in the kernel.
#
# CAP_SYS_ADMIN covers:
#   - bpf() syscall — load programs, create maps, read/write maps
#   - perf_event_open() — kprobe / tracepoint attachment
#   - reads of tracefs / debugfs format files
#
# We also grant CAP_SYSLOG explicitly. Without it, RHEL 8 kernels with
# kallsyms-restriction backports (CVE-2017-18017 and successors) return
# a TRUNCATED /proc/kallsyms to the process: addresses are zeroed AND
# module-local 't'-typed symbols (including mlx5_ib_post_send,
# mlx5_ib_poll_cq) are filtered out, even though `cat /proc/kallsyms`
# as a shell user shows them. The result is that argusd's CQ-jitter
# kprobes silently fail to attach because their target symbols look
# missing. CapabilityBoundingSet caps the effective set even for root,
# so root alone is not enough — the cap must be in the bound.
#
# For kernel ≥ 5.8 with modern systemd (≥ 247): drop in the file
# /usr/lib/systemd/system/argusd.service.d/modern-caps.conf which the
# RPM ships at /usr/share/argus/systemd/modern-caps.conf. It overrides
# the cap set to fine-grained CAP_BPF + CAP_PERFMON + CAP_SYSLOG +
# CAP_DAC_READ_SEARCH. Activate with:
#
#   sudo mkdir -p /etc/systemd/system/argusd.service.d/
#   sudo cp /usr/share/argus/systemd/modern-caps.conf \
#       /etc/systemd/system/argusd.service.d/modern-caps.conf
#   sudo systemctl daemon-reload
#   sudo systemctl restart argusd
#
# For --action-port-disable, also grant CAP_NET_ADMIN via a drop-in.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYSLOG
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYSLOG

# --- Privilege Escalation Prevention ---
NoNewPrivileges=yes
SecureBits=noroot-locked

# --- Filesystem Isolation ---
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
# ProtectKernelTunables=yes is INTENTIONALLY DISABLED here.
#
# systemd documents that this option, beyond making /proc/sys read-only,
# also makes /proc/kallsyms AND /proc/kcore *inaccessible to all
# processes regardless of capabilities*. argusd needs to read
# /proc/kallsyms at startup to discover which kernel functions are
# available as kprobe targets (mlx5_ib_post_send, mlx5_ib_poll_cq, etc.)
# for CQ-jitter micro-stall detection. With ProtectKernelTunables=yes
# the read fails EACCES even with CAP_SYS_ADMIN+CAP_SYSLOG, and the
# CQ-jitter data path is silently dead.
#
# The security cost is small: argusd does not write to /proc/sys (only
# reads sysctl values for observability), and the other hardening still
# in effect (ProtectKernelModules, NoNewPrivileges, SystemCallFilter,
# MemoryDenyWriteExecute, narrow caps) covers the realistic attack
# surface. ReadOnlyPaths below restores the read-only enforcement for
# the few sysfs/proc paths argusd actually touches.
ProtectKernelTunables=no
ProtectControlGroups=yes

# NOTE: ProtectKernelLogs / ProtectClock / ProtectHostname are
# systemd 241+ directives. Rocky 8 / RHEL 8 ship systemd 239 which
# parses these as "Unknown lvalue" and warns on every daemon-reload.
# The warning is noise — systemd ignores unknown keys, the unit
# still loads and runs correctly — but operators see it and assume
# the unit is broken.
#
# Sites on modern systemd (RHEL 9, Ubuntu 22+, etc.) who DO want
# the extra hardening can drop in:
#     /etc/systemd/system/argusd.service.d/hardening-modern.conf
# with the three directives above. The RPM doesn't auto-install it
# for the same reason it doesn't auto-load the SELinux module —
# integrations stay out of the default install.

# Managed directories (systemd creates with correct ownership)
RuntimeDirectory=argus
RuntimeDirectoryMode=0750
StateDirectory=argus
StateDirectoryMode=0750
LogsDirectory=argus
LogsDirectoryMode=0750

# Explicit filesystem grants (principle of least privilege)
ReadWritePaths=/run/argus /var/lib/argus
ReadOnlyPaths=/sys/class/infiniband
ReadOnlyPaths=/sys/kernel/tracing/events
ReadOnlyPaths=/sys/kernel/debug/tracing/events
ReadOnlyPaths=/sys/kernel/btf
ReadOnlyPaths=/proc/kallsyms
ReadOnlyPaths=/proc/sys/kernel/osrelease

# ProtectProc=invisible is a systemd 247+ directive. Same Rocky 8
# systemd 239 noise as the block above — moved out to the optional
# hardening-modern drop-in to avoid the daemon-reload warning.

# --- Process Isolation ---
UMask=0077
LockPersonality=yes
RestrictSUIDSGID=yes
RemoveIPC=yes

# --- Memory Protection ---
MemoryDenyWriteExecute=yes

# --- Network Restriction ---
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# --- Syscall Filtering (layered: allowlist, denylist, re-allow) ---
SystemCallArchitectures=native
SystemCallFilter=@system-service @io-event @network-io
SystemCallFilter=~@mount @swap @reboot @obsolete @cpu-emulation @clock @debug
SystemCallFilter=~process_vm_readv process_vm_writev ptrace
SystemCallFilter=bpf perf_event_open capset capget prctl

# --- Scheduling & Namespace ---
RestrictRealtime=yes
RestrictNamespaces=yes
DevicePolicy=closed

# --- Logging ---
StandardOutput=journal
StandardError=journal
SyslogIdentifier=argusd

[Install]
WantedBy=multi-user.target
